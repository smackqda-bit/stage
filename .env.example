# Скопируйте в .env.local для локальной разработки.
# На хостинге ONREZA задайте те же ключи в Project → Settings → Environment Variables.

# Telegram-бот, в который приходят заявки (секрет: только сервер, в браузер не попадает)
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token
# ID чата / группы, куда бот пишет заявки (для группы — отрицательное число, например -1001234567890)
TELEGRAM_CHAT_ID=123456789

# Яндекс.Метрика — номер счётчика (только цифры). Пусто — счётчик не подключается.
NEXT_PUBLIC_YM_ID=

# Боевой адрес сайта без слеша в конце (для canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://stage60.ru
